// RUN: mlir-translate --import-dxsa-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxsa-hex %s | mlir-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.atomic_umin u<0>, r<0>, r<1, <x>>
0x070000b1, 0x0011e000, 0x00000000, 0x00100e46, 0x00000000, 0x0010000a, 0x00000001

// CHECK-NEXT:   dxsa.atomic_umin g<0>, r<2>, r<3, <x>>
0x070000b1, 0x0011f000, 0x00000000, 0x00100e46, 0x00000002, 0x0010000a, 0x00000003

// CHECK-NEXT: }
