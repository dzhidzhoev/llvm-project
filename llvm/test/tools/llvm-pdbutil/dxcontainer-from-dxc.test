# REQUIRES: zlib

# RUN: llvm-pdbutil yaml2pdb %s --pdb=%t.pdb
# RUN: llvm-pdbutil pdb2yaml --all %t.pdb > %t.yaml
# RUN: llvm-pdbutil yaml2pdb %t.yaml --pdb=%t.yaml.pdb

## Check that converting PDB to YAML and back results in the same binary.
# RUN: diff %t.pdb %t.yaml.pdb

## Check `dump` output for DXContainer.
# RUN: llvm-pdbutil dump --streams --dxcontainer %t.pdb | FileCheck %s

# Checks that PDB produced by DXC can recreated with ObjectYAML.

# CHECK:                           Streams
# CHECK: ============================================================
# CHECK:   Stream 0 (  0 bytes): [Old MSF Directory]
# CHECK:   Stream 1 ( 52 bytes): [PDB Stream]
# CHECK:   Stream 2 (  0 bytes): [TPI Stream]
# CHECK:   Stream 3 (  0 bytes): [DBI Stream]
# CHECK:   Stream 4 (  0 bytes): [IPI Stream]
# CHECK:   Stream 5 (3512 bytes): [DXContainer Stream]

# CHECK:                      DirectX Container
# CHECK: ============================================================
# CHECK:   Hash: 00000000000000000000000000000000
# CHECK:   Version:
# CHECK:     Major: 1
# CHECK:     Minor: 0
# CHECK:   FileSize: 3512
# CHECK:   PartCount: 5
# CHECK:   Parts:
# CHECK:     ILDN | offset = 52, size = 72
