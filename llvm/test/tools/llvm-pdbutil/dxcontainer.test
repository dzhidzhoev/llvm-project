## Check DXContainer support within a PDB file.

# RUN: llvm-pdbutil yaml2pdb %s --pdb=%t.pdb
# RUN: llvm-pdbutil pdb2yaml --all %t.pdb > %t.yaml
# RUN: llvm-pdbutil yaml2pdb %t.yaml --pdb=%t.yaml.pdb

## Check that converting YAML to PDB and back results in the same YAML.
# RUN: FileCheck -input-file=%t.yaml %s --check-prefix=YAML

## Check that converting PDB to YAML and back results in the same binary.
# RUN: diff %t.pdb %t.yaml.pdb

## Check `dump` output for DXContainer.
# RUN: llvm-pdbutil dump --streams --dxcontainer %t.pdb | FileCheck %s

# CHECK:                           Streams
# CHECK: ============================================================
# CHECK:   Stream 0 (  0 bytes): [Old MSF Directory]
# CHECK:   Stream 1 ( 52 bytes): [PDB Stream]
# CHECK:   Stream 2 (  0 bytes): [TPI Stream]
# CHECK:   Stream 3 (  0 bytes): [DBI Stream]
# CHECK:   Stream 4 (  0 bytes): [IPI Stream]
# CHECK:   Stream 5 (140 bytes): [DXContainer Stream]

# CHECK:                      DirectX Container
# CHECK: ============================================================
# CHECK:   Hash: 00000000000000000000000000000000
# CHECK:   Version:
# CHECK:     Major: 1
# CHECK:     Minor: 0
# CHECK:   FileSize: 140
# CHECK:   PartCount: 3
# CHECK:   Parts:
# CHECK:     ILDN | offset = 52, size = 16
# CHECK:     HASH | offset = 76, size = 20
# CHECK:     ILDB | offset = 104, size = 28

# YAML: ---
# YAML: MSF:
# YAML:   SuperBlock:
# YAML:     BlockSize:       512
# YAML:     FreeBlockMap:    2
# YAML:     NumBlocks:       7
# YAML:     NumDirectoryBytes: 36
# YAML:     Unknown1:        0
# YAML:     BlockMapAddr:    3
# YAML:   NumDirectoryBlocks: 1
# YAML:   DirectoryBlocks: [ 6 ]
# YAML:   NumStreams:      6
# YAML:   FileSize:        3584
# YAML: StreamSizes:     [ 0, 52, 0, 0, 0, 140 ]
# YAML: StreamMap:
# YAML:   - Stream:          [  ]
# YAML:   - Stream:          [ 5 ]
# YAML:   - Stream:          [  ]
# YAML:   - Stream:          [  ]
# YAML:   - Stream:          [  ]
# YAML:   - Stream:          [ 4 ]
# YAML: PdbStream:
# YAML:   Age:             1
# YAML:   Guid:            '{15C920AB-F953-7F22-4045-454D275D98D6}'
# YAML:   Signature:       0
# YAML:   Version:         VC70
# YAML: PublicsStream:
# YAML:   Records:         []
# YAML: DXContainerStream:
# YAML:   DXContainer: !dxcontainer
# YAML:     Header:
# YAML:       Hash:            [ 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
# YAML:                          0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
# YAML:       Version:
# YAML:         Major:           1
# YAML:         Minor:           0
# YAML:       FileSize:        140
# YAML:       PartCount:       3
# YAML:       PartOffsets:     [ 52, 76, 104 ]
# YAML:     Parts:
# YAML:       - Name:            ILDN
# YAML:         Size:            16
# YAML:         DebugName:
# YAML:           Flags:           0
# YAML:           NameLength:      10
# YAML:           DebugName:       simple.pdb
# YAML:       - Name:            HASH
# YAML:         Size:            20
# YAML:         Hash:
# YAML:           IncludesSource:  false
# YAML:           Digest:          [ 0xAB, 0x20, 0xC9, 0x15, 0x53, 0xF9, 0x22,
# YAML:                              0x7F, 0x40, 0x45, 0x45, 0x4D, 0x27, 0x5D,
# YAML:                              0x98, 0xD6 ]
# YAML:       - Name:            ILDB
# YAML:         Size:            28
# YAML:         Program:
# YAML:           MajorVersion:    6
# YAML:           MinorVersion:    5
# YAML:           ShaderKind:      6
# YAML:           Size:            8
# YAML:           DXILMajorVersion: 1
# YAML:           DXILMinorVersion: 5
# YAML:           DXILSize:        4
# YAML:           DXIL:            [ 0x42, 0x43, 0xC0, 0xDE ]
# YAML: ...


---
MSF:
  SuperBlock:
    BlockSize:       512
    FreeBlockMap:    2
    NumBlocks:       7
    NumDirectoryBytes: 36
    Unknown1:        0
    BlockMapAddr:    3
  NumDirectoryBlocks: 1
  DirectoryBlocks: [ 6 ]
  NumStreams:      6
  FileSize:        3584
StreamSizes:     [ 0, 52, 0, 0, 0, 140 ]
StreamMap:
  - Stream:          [  ]
  - Stream:          [ 5 ]
  - Stream:          [  ]
  - Stream:          [  ]
  - Stream:          [  ]
  - Stream:          [ 4 ]
PdbStream:
  Age:             1
  Guid:            '{15C920AB-F953-7F22-4045-454D275D98D6}'
  Signature:       0
  Version:         VC70
PublicsStream:
  Records:         []
DXContainerStream:
  DXContainer: !dxcontainer
    Header:
      Hash:            [ 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
                         0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
      Version:
        Major:           1
        Minor:           0
      FileSize:        140
      PartCount:       3
      PartOffsets:     [ 52, 76, 104 ]
    Parts:
      - Name:            ILDN
        Size:            16
        DebugName:
          Flags:           0
          NameLength:      10
          DebugName:       simple.pdb
      - Name:            HASH
        Size:            20
        Hash:
          IncludesSource:  false
          Digest:          [ 0xAB, 0x20, 0xC9, 0x15, 0x53, 0xF9, 0x22,
                             0x7F, 0x40, 0x45, 0x45, 0x4D, 0x27, 0x5D,
                             0x98, 0xD6 ]
      - Name:            ILDB
        Size:            28
        Program:
          MajorVersion:    6
          MinorVersion:    5
          ShaderKind:      6
          Size:            8
          DXILMajorVersion: 1
          DXILMinorVersion: 5
          DXILSize:        4
          DXIL:            [ 0x42, 0x43, 0xC0, 0xDE ]
...
